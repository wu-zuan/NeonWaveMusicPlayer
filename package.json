{
  "name": "neon-wave-music-player",
  "private": true,
  "version": "7.0.9",
  "description": "A modern, high-fidelity music player with 8D spatial audio effects.",
  "author": "wu-zuan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wu-zuan/NeonWaveMusicPlayer.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "clean": "node scripts/clean.cjs",
    "build": "node scripts/build-desktop.mjs",
    "build:dir": "node scripts/build-desktop.mjs --no-bundle",
    "typecheck": "tsc --noEmit",
    "test:party": "node --test tests/partyRoom.test.cjs",
    "test:filenames": "node --experimental-strip-types --test tests/youtubeFilename.test.ts",
    "test:lyrics-timeline": "node --experimental-strip-types --test tests/lyricsTimelineStability.test.ts",
    "test:performance": "node --experimental-strip-types --test tests/artworkLoader.test.ts tests/audioEngine.test.ts tests/mediaMetadata.test.ts tests/playbackClock.test.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "e2e": "node scripts/e2e-playback.cjs",
    "e2e:performance": "node scripts/e2e-performance.cjs",
    "release": "powershell -ExecutionPolicy Bypass -File ./scripts/publish.ps1",
    "tauri": "tauri",
    "dev:frontend": "vite --host 127.0.0.1",
    "build:frontend": "tsc && vite build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "prepare:desktop": "npm run build:sidecar && npm run build:frontend",
    "test:native": "node --test tests/sidecar.test.cjs tests/transport.test.cjs tests/sidecar-packaging.test.cjs",
    "test": "npm run test:party && npm run test:filenames && npm run test:lyrics-timeline && npm run test:performance && npm run test:native"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.9",
    "discord.js": "^14.25.1",
    "extract-zip": "^2.0.1",
    "ffmpeg-static": "^5.3.0",
    "get-artist-title": "^1.3.1",
    "libsodium-wrappers": "^0.8.1",
    "opencc-js": "^1.0.5",
    "opusscript": "0.0.8",
    "pinyin-pro": "^3.28.2",
    "yt-dlp-wrap": "^2.3.12",
    "yt-search": "^2.13.1",
    "discord-rpc": "^4.0.1",
    "music-metadata": "^11.10.3",
    "ws": "^8.21.1",
    "@tauri-apps/api": "^2.10.1",
    "classic-level": "^3.0.0"
  },
  "devDependencies": {
    "@types/discord-rpc": "^4.0.10",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^2.2.7",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  }
}
